<?xml version="1.0" encoding="UTF-8"?>
<!--
  SUMO Configuration File for Single-Intersection Simulation.
  
  This file ties together the network, routes, and simulation parameters.
  It is passed to SUMO/sumo-gui as the primary config argument:
    sumo -c single_intersection.sumocfg
  
  Key parameters explained:
    step-length  : simulation time step in seconds (1.0s per step)
    begin/end    : simulation time range in seconds
    seed         : random seed for reproducibility
    no-step-log  : suppress per-step console output (faster training)
    waiting-time-memory: how far back SUMO tracks vehicle waiting time
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <!-- Road network geometry and traffic light definitions -->
        <net-file value="single_intersection.net.xml"/>
        <!-- Vehicle demand: routes and flow definitions -->
        <route-files value="single_intersection.rou.xml"/>
    </input>

    <time>
        <!-- Start at t=0 seconds -->
        <begin value="0"/>
        <!-- End at t=3600 seconds (1 simulated hour max) -->
        <!-- Episodes are terminated earlier by our Python environment -->
        <end value="3600"/>
    </time>

    <processing>
        <!-- 1-second simulation steps: fine enough for traffic control -->
        <step-length value="1.0"/>
        <!-- Vehicles teleport after waiting >300s (prevents deadlock) -->
        <time-to-teleport value="300"/>
        <!-- Track waiting time over a 200-step rolling window -->
        <waiting-time-memory value="200"/>
        <!-- Allow vehicles to collide for brief moments (realistic) -->
        <collision.action value="warn"/>
    </processing>

    <report>
        <!-- Suppress verbose console logs during RL training -->
        <no-step-log value="true"/>
        <!-- Suppress version banner -->
        <no-warnings value="false"/>
        <!-- Suppress duration/summary at end of simulation -->
        <duration-log.disable value="true"/>
    </report>

    <random>
        <!-- Fixed seed — our Python code overrides this per episode -->
        <seed value="42"/>
    </random>

</configuration>
